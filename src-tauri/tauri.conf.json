{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIOrganizerPro",
  "version": "0.2.0",
  "identifier": "id.local.aiorganizerpro",
  "build": {
    "frontendDist": "../gui",
    "devUrl": "http://127.0.0.1:8471",
    "beforeBuildCommand": "",
    "beforeDevCommand": "node ../server/server.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "AIOrganizerPro",
        "width": 1520,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost blob: data:; connect-src 'self' http://127.0.0.1:8471; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": [
            "**/*"
          ]
        }
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "resources": [
      "../aiorganizer.exe",
      "../engine-py"
    ]
  }
}
